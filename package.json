{
  "name": "@univpahlawan/sso-client-next",
  "version": "1.1.0",
  "description": "Klien SSO Universitas Pahlawan (OAuth2 / OIDC) untuk aplikasi Next.js App Router, Pages Router, dan NextAuth.js. Dikelola oleh UPT Komputer & Sistem Informasi UP.",
  "author": "UPT Komputer & Sistem Informasi, Universitas Pahlawan Tuanku Tambusai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Puskom-UP/sso-client-next.git"
  },
  "homepage": "https://github.com/Puskom-UP/sso-client-next#readme",
  "keywords": [
    "sso",
    "oauth2",
    "oidc",
    "nextjs",
    "universitas-pahlawan",
    "sains",
    "next-auth"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.mjs",
      "require": "./dist/next/index.js"
    },
    "./next-auth": {
      "types": "./dist/next-auth/index.d.ts",
      "import": "./dist/next-auth/index.mjs",
      "require": "./dist/next-auth/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "next": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
